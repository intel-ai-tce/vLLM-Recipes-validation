# Weekly Xeon 6 recipe validation settings.
# Override any of these in the GitHub Actions job/environment when needed.
RECIPES_BASE_URL=${RECIPES_BASE_URL:-https://recipes.vllm.ai}
# Empty repository uses the recipe tools bundled in VLLM_IMAGE.
RECIPE_TOOLS_REPO=${RECIPE_TOOLS_REPO:-}
RECIPE_TOOLS_REF=${RECIPE_TOOLS_REF:-main}
VLLM_IMAGE=${VLLM_IMAGE:-vllm/vllm-openai-cpu:latest-x86_64}
HARDWARE=${HARDWARE:-xeon6}

# Optional exact model ID for a manual/debug run. Empty means all discovered
# Xeon 6 models.
TEST_MODEL=${TEST_MODEL:-}

# Quick performance smoke test
BENCH_INPUT_LEN=${BENCH_INPUT_LEN:-128}
BENCH_OUTPUT_LEN=${BENCH_OUTPUT_LEN:-128}
BENCH_NUM_PROMPTS=${BENCH_NUM_PROMPTS:-5}
BENCH_MAX_CONCURRENCY=${BENCH_MAX_CONCURRENCY:-1}
BENCH_REQUEST_RATE=${BENCH_REQUEST_RATE:-inf}

# Runtime controls. serve_with_recipe.sh starts the normal vLLM endpoint on
# port 8000; health checks and vllm bench execute inside that same container.
VLLM_HOST=${VLLM_HOST:-127.0.0.1}
VLLM_PORT=${VLLM_PORT:-8000}
SERVER_START_TIMEOUT_SEC=${SERVER_START_TIMEOUT_SEC:-3600}
BENCH_TIMEOUT_SEC=${BENCH_TIMEOUT_SEC:-1800}

# Workspace. HF_HOME should normally point at a persistent disk on the runner.
WORK_ROOT=${WORK_ROOT:-${GITHUB_WORKSPACE:-$PWD}/work}
RESULT_ROOT=${RESULT_ROOT:-${GITHUB_WORKSPACE:-$PWD}/results}
VALIDATED_ROOT=${VALIDATED_ROOT:-${GITHUB_WORKSPACE:-$PWD}/validated}
HF_HOME=${HF_HOME:-$HOME/.cache/huggingface}
